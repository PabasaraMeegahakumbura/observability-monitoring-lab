#!/bin/bash

# Sanitized Telegram notification script for Nagios.
# Copy this file to /usr/local/nagios/libexec/notify_telegram.sh on the Nagios server.
# Store BOT_TOKEN and CHAT_ID in /usr/local/nagios/etc/private/telegram.env.
# Never commit the real telegram.env file.

ENV_FILE="/usr/local/nagios/etc/private/telegram.env"

if [ ! -f "$ENV_FILE" ]; then
    echo "Telegram env file not found"
    exit 1
fi

source "$ENV_FILE"

ALERT_TYPE="$1"
STATE="$2"
HOST="$3"
SERVICE="$4"
OUTPUT="$5"
DATE_TIME=$(date '+%Y-%m-%d %H:%M:%S %Z')

if [ "$ALERT_TYPE" = "SERVICE" ]; then
    MESSAGE="Nagios Service Alert
Time: $DATE_TIME
Host: $HOST
Service: $SERVICE
State: $STATE
Output: $OUTPUT"
else
    MESSAGE="Nagios Host Alert
Time: $DATE_TIME
Host: $HOST
State: $STATE
Output: $OUTPUT"
fi

curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${CHAT_ID}" \
    --data-urlencode "text=${MESSAGE}" >/dev/null
